+/// A rendered directory failure, distinct from an output writer failure.
+#[derive(Debug)]
+pub(crate) struct DirectoryReadError(pub io::Error);
+impl std::fmt::Display for DirectoryReadError {
+ fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { self.0.fmt(f) }
+}
+impl std::error::Error for DirectoryReadError {}
+fn retain_error(current: &mut Option<io::Error>, error: io::Error) {
+ if current.is_none() || error.kind() == io::ErrorKind::PermissionDenied { *current = Some(error); }
+}
