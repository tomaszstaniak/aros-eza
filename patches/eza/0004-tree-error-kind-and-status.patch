+    /// Keep already-rendered directory failures distinct from output failures.
+    fn print_files_status(&mut self, dir: Option<&Dir>, files: Vec<File<'_>>) -> io::Result<i32> {
+        match self.print_files(dir, files) {
+            Ok(()) => Ok(exits::SUCCESS),
+            Err(error) if error.get_ref().is_some_and(|e| e.is::<details::DirectoryReadError>()) => {
+                Ok(if error.kind() == ErrorKind::PermissionDenied { exits::PERMISSION_DENIED } else { exits::RUNTIME_ERROR })
+            }
+            Err(error) => Err(error),
+        }
+    }
+
