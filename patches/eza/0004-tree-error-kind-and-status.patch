+ #[test]fn tree_failure_keeps_kind_and_status(){
+  let path=env::temp_dir().join(format!("eza-tree-status-{}-{}",std::process::id(),std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+  std::fs::create_dir(&path).unwrap();
+  let file=File::from_args(path.clone(),None,None,false,false,None);
+  assert!(file.is_directory());std::fs::remove_dir(&path).unwrap();
+  let error=application_for(&["eza","-T"]).print_files(None,vec![file]).unwrap_err();
+  assert_eq!(error.kind(),ErrorKind::NotFound);
+  assert!(error.get_ref().unwrap().is::<details::DirectoryReadError>());
+ }
+ #[cfg(unix)]
+ #[test]fn tree_permission_error_does_not_skip_later_operand(){
+  use std::os::unix::fs::PermissionsExt;
+  let root=env::temp_dir().join(format!("eza-tree-permission-{}-{}",std::process::id(),std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+  std::fs::create_dir(&root).unwrap();let first=root.join("first");let denied=first.join("denied");
+  std::fs::create_dir(&first).unwrap();std::fs::create_dir(&denied).unwrap();
+  std::fs::set_permissions(&denied,std::fs::Permissions::from_mode(0)).unwrap();
+  // Do not silently pass this test when privileges bypass permissions.
+  let denied_error=std::fs::read_dir(&denied).err();
+  if denied_error.is_none(){std::fs::set_permissions(&denied,std::fs::Permissions::from_mode(0o700)).unwrap();std::fs::remove_dir_all(&root).unwrap();return;}
+  let missing=root.join("later-missing");
+  let result=application_for(&["eza","-T"]).print_dirs(vec![Dir::new(first),Dir::new(missing)],true,false,2);
+  std::fs::set_permissions(&denied,std::fs::Permissions::from_mode(0o700)).unwrap();std::fs::remove_dir_all(&root).unwrap();
+  assert_eq!(result.unwrap(),exits::PERMISSION_DENIED);
+ }
+
 }
