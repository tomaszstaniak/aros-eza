+// SPDX-License-Identifier: EUPL-1.2
+#[derive(Default, Debug, Clone, Copy)]
+#[repr(C)]
+pub struct Presentation { pub known:u32, pub colors:u32, pub styles:u32, pub lines:u32, pub rows:u32, pub columns:u32, pub interpretation:u32, pub input:u32, pub features:u32 }
+pub fn rich_width(status:i32, p:Presentation)->Option<usize>{
+ if status == 0 && p.known & 9 == 9 && (2..=3).contains(&p.colors) && p.rows > 0 && p.columns > 0 {Some(p.columns as usize)} else {None}
+}
+#[cfg(test)] mod tests {
+ use super::*;
+ fn compatible()->Presentation { Presentation {known:9, colors:2, rows:24, columns:80,..Default::default()} }
+ #[test] fn accepts_any_console_with_contract(){assert_eq!(rich_width(0,compatible()),Some(80));}
+ #[test] fn ignores_unknown_bits(){let mut p=compatible();p.known|=1<<31;assert_eq!(rich_width(0,p),Some(80));}
+ #[test] fn refuses_unknown_absent_or_invalid(){for p in [Presentation::default(),Presentation{known:1,..compatible()},Presentation{rows:0,..compatible()},Presentation{colors:1,..compatible()},Presentation{colors:99,..compatible()}]{assert_eq!(rich_width(0,p),None);}assert_eq!(rich_width(1,compatible()),None);}
+}
+
+pub fn sgr(params:&str,rgb:bool)->String{
+ let parts:Vec<u32>=params.split(';').map(|v|v.parse().unwrap_or(0)).collect();
+ let mut out=Vec::new();let mut i=0;
+ while i<parts.len(){let v=parts[i];
+  if (v==38||v==48)&&i+2<parts.len()&&parts[i+1]==5 {out.extend(parts[i..i+3].iter().map(u32::to_string));i+=3;continue;}
+  if (v==38||v==48)&&i+4<parts.len()&&parts[i+1]==2 {
+   if rgb {out.extend(parts[i..i+5].iter().map(u32::to_string));}
+   else {let q=|x:u32|(x.min(255)*5+127)/255;let n=16+36*q(parts[i+2])+6*q(parts[i+3])+q(parts[i+4]);out.extend([v.to_string(),"5".into(),n.to_string()]);}i+=5;continue;
+  }
+  let pair=match v{30..=37=>Some((38,v-30)),40..=47=>Some((48,v-40)),90..=97=>Some((38,v-90+8)),100..=107=>Some((48,v-100+8)),_=>None};
+  if let Some((kind,n))=pair{out.extend([kind.to_string(),"5".into(),n.to_string()]);}else{out.push(v.to_string());}i+=1;
+ }out.join(";")
+}
+pub fn protection(bits:u32)->String{
+ "hsparwed".chars().enumerate().map(|(i,c)|{let set=bits&(1<<(7-i))!=0;if set==(i<4){c}else{'-'}}).collect()
+}
+#[cfg(test)] mod more_tests {
+ use super::*;
+ #[test] fn maps_amiga_pens_without_rewriting_index_arguments(){assert_eq!(sgr("1;34;48;5;31",false),"1;38;5;4;48;5;31");assert_eq!(sgr("91;104",true),"38;5;9;48;5;12");}
+ #[test] fn reduces_rgb_only_when_unconfirmed(){assert_eq!(sgr("38;2;255;0;0",false),"38;5;196");assert_eq!(sgr("38;2;255;0;0",true),"38;2;255;0;0");}
+ #[test] fn displays_native_protection_in_dos_order(){assert_eq!(protection(0),"----rwed");assert_eq!(protection(0xff),"hspa----");assert_eq!(protection(8),"-----wed");}
+}
+
+pub struct Output<W:std::io::Write>{pub inner:W,pub rich:bool,pub rgb:bool,pending:Vec<u8>}
+impl<W:std::io::Write> Output<W>{pub fn new(inner:W,rich:bool,rgb:bool)->Self{Self{inner,rich,rgb,pending:Vec::new()}}}
+impl<W:std::io::Write> std::io::Write for Output<W>{
+ fn write(&mut self,bytes:&[u8])->std::io::Result<usize>{
+ #[cfg(target_os="aros")] crate::aros::interrupted();
+ let mut output=Vec::with_capacity(bytes.len());
+ for &b in bytes {
+  if self.pending.is_empty(){if b==27 {self.pending.push(b);}else{output.push(b);}continue;}
+  self.pending.push(b);
+  if self.pending.len()==2 && b!=b'[' {self.pending.clear();continue;}
+  if self.pending.len()>2 && (0x40..=0x7e).contains(&b){
+   if b==b'm' && self.rich {let params=std::str::from_utf8(&self.pending[2..self.pending.len()-1]).unwrap_or("");output.extend_from_slice(format!("\x1b[{}m",sgr(params,self.rgb)).as_bytes());}
+   self.pending.clear();
+  }else if self.pending.len()>256 {self.pending.clear();}
+ }
+ self.inner.write_all(&output)?;Ok(bytes.len())
+}
+ fn flush(&mut self)->std::io::Result<()>{self.inner.flush()}
+}
+#[cfg(test)] mod writer_tests{
+ use super::*;use std::io::Write;
+ #[test]fn split_sequences_map_and_plain_strips(){for rich in [false,true]{let mut w=Output::new(Vec::new(),rich,false);for chunk in [b"\x1b[3".as_slice(),b"4mname\x1b[0m\n"]{w.write_all(chunk).unwrap();}assert_eq!(w.inner,if rich{b"\x1b[38;5;4mname\x1b[0m\n".to_vec()}else{b"name\n".to_vec()});}}
+}
+
+pub fn filename(bytes:&[u8])->String {
+ if bytes.ends_with(b"//") {return String::from_utf8_lossy(bytes).into_owned();}
+ let bytes=if bytes.len()>1 && bytes.ends_with(b"/") {&bytes[..bytes.len()-1]}else{bytes};
+ let end=bytes.len();let mut start=bytes.iter().rposition(|b| *b==b'/' || *b==b':').map_or(0,|i|i+1);
+ if start==end {start=0;}
+ let mut input=&bytes[start..];let mut out=String::new();
+ while !input.is_empty(){match std::str::from_utf8(input){Ok(text)=>{out.push_str(text);break;},Err(e)=>{
+ let valid=e.valid_up_to();out.push_str(std::str::from_utf8(&input[..valid]).unwrap());
+ let n=e.error_len().unwrap_or(input.len()-valid);for b in &input[valid..valid+n]{out.push_str(&format!("\\x{b:02x}"));}input=&input[valid+n..];
+ }}}out
+}
+#[cfg(test)] mod path_tests {use super::*;
+ #[test]fn amiga_names_and_invalid_bytes_are_preserved(){assert_eq!(filename(b"RAM:folder/file name"),"file name");assert_eq!(filename(b"RAM:one"),"one");assert_eq!(filename(b"SYS:"),"SYS:");assert_eq!(filename(b"a/\xff.bin"),"\\xff.bin");assert_eq!(filename("RAM:zażółć".as_bytes()),"zażółć");}
+}
+
+#[cfg(test)] mod trailing_tests {use super::*;
+ #[test]fn directory_separator_and_parent_references(){assert_eq!(filename(b"RAM:a/b/"),"b");assert_eq!(filename(b"RAM:a//"),"RAM:a//");assert_eq!(filename(b"/"),"/");assert_eq!(filename(b"RAM:"),"RAM:");}
+}
