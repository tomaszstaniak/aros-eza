+/* SPDX-License-Identifier: EUPL-1.2 */
+#include <stddef.h>
+#include <limpet/limpet.h>
+#include <proto/dos.h>
+_Static_assert(sizeof(LimpetPresentation)==36,"presentation layout");
+int eza_query(LimpetPresentation *p) { LONG error=0; return limpet_query_presentation(Output(),p,&error); }
+
+#include <exec/tasks.h>
+#include <dos/dos.h>
+#include <proto/exec.h>
+int eza_break(void) { return (SetSignal(0,0)&SIGBREAKF_CTRL_C)!=0; }
+int eza_protection(const char *path, unsigned int *bits) {
+ BPTR lock=Lock(path,ACCESS_READ); if (!lock) return 0;
+ struct FileInfoBlock *fib=AllocDosObject(DOS_FIB,0); int ok=0;
+ if(fib){if(Examine(lock,fib)){*bits=(unsigned int)fib->fib_Protection;ok=1;}FreeDosObject(DOS_FIB,fib);}UnLock(lock);return ok;
+}
