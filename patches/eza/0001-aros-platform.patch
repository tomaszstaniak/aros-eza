+// SPDX-License-Identifier: EUPL-1.2
+use crate::aros_policy::{Presentation,rich_width};
+use std::sync::OnceLock;
+#[link(name="ezaaros",kind="static")]
+unsafe extern "C" { fn eza_query(p:*mut Presentation)->i32; fn eza_break()->i32; fn eza_protection(path:*const std::ffi::c_char,bits:*mut u32)->i32; }
+static WIDTH:OnceLock<Option<usize>>=OnceLock::new();
+pub fn width()->Option<usize>{*WIDTH.get_or_init(||{let mut p=Presentation::default();let status=unsafe{eza_query(&mut p)};rich_width(status,p)})}
+pub fn initialize(){
+ use std::io::IsTerminal;
+ if std::io::stdout().is_terminal() && width().is_none(){
+  eprintln!("eza: This console does not provide the required colour and size capabilities. Run eza in Limpet or another compatible console.");std::process::exit(5);
+ }
+
+}
+
+pub fn interrupted(){if unsafe{eza_break()}!=0 {
+ use std::io::{IsTerminal,Write};
+ if std::io::stdout().is_terminal() && width().is_some(){let _=std::io::stdout().write_all(b"\x1b[0m\n");}
+ eprintln!("eza: Interrupted");std::process::exit(5);
+}}
+pub fn native_protection(path:&std::path::Path)->Option<u32>{
+ use std::os::unix::ffi::OsStrExt;
+ let path=std::ffi::CString::new(path.as_os_str().as_bytes()).ok()?;let mut bits=0;
+ if unsafe{eza_protection(path.as_ptr(),&mut bits)}!=0 {Some(bits)}else{None}
+}
+
+pub fn writer()->crate::aros_policy::Output<std::io::Stdout>{
+ use std::io::IsTerminal;
+ let mut p=Presentation::default();let rich=std::io::stdout().is_terminal();
+ if rich {unsafe{eza_query(&mut p)};}
+ crate::aros_policy::Output::new(std::io::stdout(),rich,p.colors==3)
+}
