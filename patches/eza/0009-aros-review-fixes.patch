                         let mut i = 0;
                         while i < parts.len() {
                             let v = parts[i].parse::<u32>().unwrap_or(0);
-                            if (v == 38 || v == 48) && i + 2 < parts.len() {
-                                let n = if parts[i + 1] == "2" { 5 } else { 3 };
+                            if v == 38 || v == 48 {
+                                let n = if parts.get(i + 1) == Some(&"2") { 5 } else { 3 };
                                 if i + n <= parts.len() {
                                     kept.extend_from_slice(&parts[i..i + n]);
                                     i += n;
                                     continue;
                                 }
+                                // Truncated colour: its "5" must not become blink.
+                                break;
                             }
                             let allowed = match v {
                                 0 | 39 | 49 => true,
@@ -244,6 +246,11 @@ impl<W: std::io::Write> std::io::Write for Output<W> {
             }
             match self.state {
                 1 => match b {
+                    // ESC ESC: the second one starts the sequence.
+                    27 => {
+                        self.pending.clear();
+                        self.pending.push(b);
+                    }
                     b'[' => self.state = 2,
                     b']' => self.state = 3,
                     b'P' | b'X' | b'^' | b'_' => self.state = 5,
@@ -500,3 +507,16 @@ mod whole_path_tests {
         assert_eq!(filename(b"RAM:a/b//"), "RAM:a/b//");
     }
 }
+
+#[cfg(test)]
+mod review_filter_tests {
+    use super::*;
+    use std::io::Write;
+    #[test]
+    fn truncated_colour_is_not_blink_and_double_escape_starts_once() {
+        let p = Presentation { known: 2, styles: 16, ..Default::default() };
+        let mut w = Output::new(Vec::new(), true, false).capabilities(p);
+        w.write_all(b"\x1b[1;38;5mA\x1b\x1b[31mB").unwrap();
+        assert_eq!(w.inner, b"A\x1b[38;5;1mB");
+    }
+}
