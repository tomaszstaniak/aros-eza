     pub const PERMISSION_DENIED: i32 = 13;
 }
+
+#[cfg(all(test, not(target_os = "aros")))]
+mod directory_error_tests {
+ use super::*;
+ fn application_for(args:&[&str]) -> Exa<'static> {
+  let cli=get_command().try_get_matches_from(args).unwrap();
+  let options=Options::deduce(&cli,&LiveVars).unwrap();let theme=options.theme.to_theme(false);
+  Exa{options,writer:io::stdout(),input_paths:vec![],theme,console_width:None,git:None,git_repos:false}
+ }
+ fn application()->Exa<'static>{application_for(&["eza"])}
+ #[test]fn unreadable_directory_returns_failure(){
+  let path=env::temp_dir().join(format!("eza-absent-{}-{:?}",std::process::id(),std::time::SystemTime::now()));
+  let result=application().print_dirs(vec![Dir::new(path)],true,true,0).unwrap();
+  assert_eq!(result,exits::RUNTIME_ERROR);
+ }
+ #[test]fn directory_error_preserves_prior_failure(){
+  let path=env::temp_dir().join(format!("eza-absent-{}-{:?}",std::process::id(),std::time::SystemTime::now()));
+  assert_eq!(application().print_dirs(vec![Dir::new(path)],true,true,2).unwrap(),2);
+ }
+ #[test]fn tree_child_enumeration_error_returns_failure(){
+  let path=env::temp_dir().join(format!("eza-removed-{}-{}",std::process::id(),std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+  std::fs::create_dir(&path).unwrap();
+  let file=File::from_args(path.clone(),None,None,false,false,None);
+  assert!(file.is_directory());
+  std::fs::remove_dir(&path).unwrap();
+  assert!(application_for(&["eza","-T"]).print_files(None,vec![file]).is_err());
+ }
+
+}
