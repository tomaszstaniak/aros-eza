                             dir.path.display(),
@@ -424,7 +426,7 @@ impl Exa<'_> {
 
                     self.print_files(Some(dir), children)?;
                     match self.print_dirs(child_dirs, false, false, exit_status) {
-                        Ok(_) => (),
+                        Ok(child_status) => exit_status = exit_status.max(child_status),
                         Err(e) => return Err(e),
