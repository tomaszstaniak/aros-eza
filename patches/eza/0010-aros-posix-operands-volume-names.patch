+/// The volume or assign before the name of an operand at a volume root
+/// ("RAM:" for "RAM:clean.txt"). Rust's Path sees a single component there
+/// and no parent, so eza printed the name alone.
+pub fn volume_prefix(bytes: &[u8]) -> Option<String> {
+    if bytes.contains(&b'/') {
+        return None;
+    }
+    let colon = bytes.iter().position(|b| *b == b':')?;
+    (colon + 1 < bytes.len()).then(|| escape_bytes(&bytes[..=colon]))
+}
+
+/// AmigaDOS form of a path written with POSIX "." and ".." components, or
+/// None when it has none. "." components go, ".." becomes a parent step:
+/// "./x" -> "x", "../x" -> "/x", "a/../b" -> "a//b", ".." -> "/". Empty
+/// components already are AmigaDOS parent steps and stay; a volume prefix
+/// stays. Callers use the result only when the path as written does not
+/// exist, because "." and ".." are legal AmigaDOS names.
+pub fn from_posix(bytes: &[u8]) -> Option<Vec<u8>> {
+    let split = match (bytes.iter().position(|b| *b == b':'), bytes.iter().position(|b| *b == b'/')) {
+        (Some(c), Some(s)) if c < s => c + 1,
+        (Some(c), None) => c + 1,
+        _ => 0,
+    };
+    let (volume, rest) = bytes.split_at(split);
+    let mut parts: Vec<&[u8]> = rest.split(|b| *b == b'/').collect();
+    if !parts.iter().any(|p| *p == b"." || *p == b"..") {
+        return None;
+    }
+    // A single trailing '/' only marks a drawer in AmigaDOS.
+    if parts.len() > 1 && parts.last() == Some(&&b""[..]) {
+        parts.pop();
+    }
+    let mut out = volume.to_vec();
+    for part in parts {
+        match part {
+            b"." => {}
+            b".." | b"" => {
+                if out.len() > volume.len() && !out.ends_with(b"/") {
+                    out.push(b'/');
+                }
+                out.push(b'/');
+            }
+            name => {
+                if out.len() > volume.len() && !out.ends_with(b"/") {
+                    out.push(b'/');
+                }
+                out.extend_from_slice(name);
+            }
+        }
+    }
+    Some(out)
+}
+
+#[cfg(test)]
+mod posix_path_tests {
+    use super::*;
+    fn t(s: &str) -> Option<String> {
+        from_posix(s.as_bytes()).map(|v| String::from_utf8(v).unwrap())
+    }
+    #[test]
+    fn dot_components_become_amigados_steps() {
+        assert_eq!(t("./x").as_deref(), Some("x"));
+        assert_eq!(t("../x").as_deref(), Some("/x"));
+        assert_eq!(t("../../x").as_deref(), Some("//x"));
+        assert_eq!(t("a/../b").as_deref(), Some("a//b"));
+        assert_eq!(t("a/./b").as_deref(), Some("a/b"));
+        assert_eq!(t("..").as_deref(), Some("/"));
+        assert_eq!(t("x/.").as_deref(), Some("x"));
+        assert_eq!(t("RAM:a/../b").as_deref(), Some("RAM:a//b"));
+        assert_eq!(t("RAM:./x").as_deref(), Some("RAM:x"));
+        assert_eq!(t("a//b/../c").as_deref(), Some("a//b//c"));
+    }
+    #[test]
+    fn plain_amigados_paths_are_left_alone() {
+        for p in ["x", "RAM:x", "/x", "a//b", "RAM:", "x/", "..x", "x.."] {
+            assert_eq!(t(p), None, "{p}");
+        }
+    }
+    #[test]
+    fn volume_prefix_only_at_a_volume_root() {
+        assert_eq!(volume_prefix(b"RAM:clean.txt").as_deref(), Some("RAM:"));
+        assert_eq!(volume_prefix(b"Ram Disk:x").as_deref(), Some("Ram Disk:"));
+        assert_eq!(volume_prefix(b"RAM:a/b"), None);
+        assert_eq!(volume_prefix(b"RAM:"), None);
+        assert_eq!(volume_prefix(b"x"), None);
+    }
+}
+
+/// Path::starts_with for AmigaDOS paths. Rust sees "RAM:x" as one component,
+/// so "RAM:x" did not start with "RAM:" and a repository at a volume root
+/// was never matched to the files listed in it.
+pub fn path_starts_with(path: &[u8], prefix: &[u8]) -> bool {
+    if !path.starts_with(prefix) {
+        return false;
+    }
+    path.len() == prefix.len()
+        || matches!(prefix.last(), Some(b':' | b'/'))
+        || path[prefix.len()] == b'/'
+}
+
+#[cfg(test)]
+mod prefix_tests {
+    use super::*;
+    #[test]
+    fn volume_roots_contain_their_files() {
+        assert!(path_starts_with(b"RAM:x", b"RAM:"));
+        assert!(path_starts_with(b"RAM:a/x", b"RAM:a"));
+        assert!(path_starts_with(b"RAM:a", b"RAM:a"));
+        assert!(!path_starts_with(b"RAM:ab", b"RAM:a"));
+        assert!(!path_starts_with(b"RAMX:x", b"RAM"));
+        assert!(path_starts_with(b"RAM:a/x", b"RAM:a/"));
+    }
+}
