 use nu_ansi_term::{AnsiStrings as ANSIStrings, Style};
 use options::parser::get_command;
@@ -39,7 +42,17 @@ mod options;
 mod output;
 mod theme;
 
+#[cfg(target_os = "aros")]
 fn main() {
+    aros::run(eza_main)
+}
+
+#[cfg(not(target_os = "aros"))]
+fn main() {
+    eza_main();
+}
+
+fn eza_main() {
     #[cfg(unix)]
     unsafe {
         libc::signal(libc::SIGPIPE, libc::SIG_DFL);
@@ -49,8 +62,16 @@ fn main() {
 
     #[cfg(not(target_os = "aros"))]
     let cli = get_command().get_matches();
+    // clap would call std::process::exit itself for --help, --version and
+    // errors; on AROS that must go through aros::exit (see aros::run).
     #[cfg(target_os = "aros")]
-    let cli = get_command().color(clap::ColorChoice::Never).get_matches();
+    let cli = get_command()
+        .color(clap::ColorChoice::Never)
+        .try_get_matches()
+        .unwrap_or_else(|e| {
+            let _ = e.print();
+            exit(e.exit_code())
+        });
 
     #[cfg(target_os = "aros")]
     aros::initialize();
