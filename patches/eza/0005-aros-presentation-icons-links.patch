+/// A streaming filter: retain incomplete control strings across writes and
+/// discard their payload until termination, including after the bounded buffer fills.
+pub struct Output<W: std::io::Write> {
+    pub inner: W,
+    pub rich: bool,
+    pub rgb: bool,
+    styles: u32,
+    hyperlinks: bool,
+    pending: Vec<u8>,
+    state: u8,
+    overflow: bool,
+}
+impl<W: std::io::Write> Output<W> {
+    pub fn new(inner: W, rich: bool, rgb: bool) -> Self {
+        Self {
+            inner,
+            rich,
+            rgb,
+            styles: 0,
+            hyperlinks: false,
+            pending: Vec::new(),
+            state: 0,
+            overflow: false,
+        }
+    }
+    pub fn capabilities(mut self, p: Presentation) -> Self {
+        self.styles = if p.known & 2 != 0 { p.styles } else { 0 };
+        self.hyperlinks = p.known & 64 != 0 && p.features & 2 != 0;
+        self
+    }
+    fn sequence(&mut self, output: &mut Vec<u8>, osc: bool) {
+        if !self.overflow && self.rich {
+            if osc {
+                if self.hyperlinks && self.pending.starts_with(b"\x1b]8;") {
+                    output.extend_from_slice(&self.pending);
+                }
+            } else if self.pending.last() == Some(&b'm') {
+                if let Ok(params) = std::str::from_utf8(&self.pending[2..self.pending.len() - 1]) {
+                    if params.bytes().all(|b| b.is_ascii_digit() || b == b';') {
+                        let mapped = sgr(params, self.rgb);
+                        let parts: Vec<&str> = mapped.split(';').collect();
+                        let mut kept = Vec::new();
+                        let mut i = 0;
+                        while i < parts.len() {
+                            let v = parts[i].parse::<u32>().unwrap_or(0);
+                            if (v == 38 || v == 48) && i + 2 < parts.len() {
+                                let n = if parts[i + 1] == "2" { 5 } else { 3 };
+                                if i + n <= parts.len() {
+                                    kept.extend_from_slice(&parts[i..i + n]);
+                                    i += n;
+                                    continue;
+                                }
+                            }
+                            let allowed = match v {
+                                0 | 39 | 49 => true,
+                                1 => self.styles & 1 != 0,
+                                22 => self.styles & 3 != 0,
+                                2 => self.styles & 2 != 0,
+                                3 | 23 => self.styles & 4 != 0,
+                                4 | 24 => self.styles & 8 != 0,
+                                5 | 25 => self.styles & 16 != 0,
+                                7 | 27 => self.styles & 32 != 0,
+                                8 | 28 => self.styles & 64 != 0,
+                                9 | 29 => self.styles & 128 != 0,
+                                _ => false,
+                            };
+                            if allowed {
+                                kept.push(parts[i]);
+                            }
+                            i += 1;
+                        }
+                        if !kept.is_empty() {
+                            output
+                                .extend_from_slice(format!("\x1b[{}m", kept.join(";")).as_bytes());
+                        }
+                    }
+                }
+            }
+        }
+        self.pending.clear();
+        self.state = 0;
+        self.overflow = false;
+    }
+}
+impl<W: std::io::Write> std::io::Write for Output<W> {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        #[cfg(target_os = "aros")]
+        crate::aros::interrupted();
+        let mut output = Vec::with_capacity(bytes.len());
+        for &b in bytes {
+            if self.state == 0 {
+                if b == 27 {
+                    self.pending.push(b);
+                    self.state = 1;
+                } else {
+                    output.push(b);
+                }
+                continue;
+            }
+            if self.pending.len() < 8192 {
+                self.pending.push(b);
+            } else {
+                self.overflow = true;
+            }
+            match self.state {
+                1 => match b {
+                    b'[' => self.state = 2,
+                    b']' => self.state = 3,
+                    b'P' | b'X' | b'^' | b'_' => self.state = 5,
+                    _ => {
+                        self.pending.clear();
+                        self.state = 0;
+                    }
+                },
+                2 => {
+                    if (0x40..=0x7e).contains(&b) {
+                        self.sequence(&mut output, false);
+                    }
+                }
+                3 | 4 => {
+                    if b == 7 || (self.state == 4 && b == b'\\') {
+                        self.sequence(&mut output, true);
+                    } else {
+                        self.state = if b == 27 { 4 } else { 3 };
+                    }
+                }
+                5 | 6 => {
+                    if self.state == 6 && b == b'\\' {
+                        self.pending.clear();
+                        self.state = 0;
+                        self.overflow = false;
+                    } else {
+                        self.state = if b == 27 { 6 } else { 5 };
+                    }
+                }
+                _ => unreachable!(),
+            }
+        }
+        self.inner.write_all(&output)?;
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.inner.flush()
+    }
+}
