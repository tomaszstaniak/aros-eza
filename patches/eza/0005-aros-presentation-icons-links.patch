+pub fn sgr(params: &str, rgb: bool) -> String {
+    let parts: Vec<u32> = params.split(';').map(|v| v.parse().unwrap_or(0)).collect();
+    let mut out = Vec::new();
+    let mut i = 0;
+    while i < parts.len() {
+        let v = parts[i];
+        if (v == 38 || v == 48) && i + 2 < parts.len() && parts[i + 1] == 5 {
+            out.extend(parts[i..i + 3].iter().map(u32::to_string));
+            i += 3;
+            continue;
+        }
+        if (v == 38 || v == 48) && i + 4 < parts.len() && parts[i + 1] == 2 {
+            if rgb {
+                out.extend(parts[i..i + 5].iter().map(u32::to_string));
+            } else {
+                let q = |x: u32| (x.min(255) * 5 + 127) / 255;
+                let n = 16 + 36 * q(parts[i + 2]) + 6 * q(parts[i + 3]) + q(parts[i + 4]);
+                out.extend([v.to_string(), "5".into(), n.to_string()]);
+            }
+            i += 5;
+            continue;
+        }
+        let pair = match v {
+            30..=37 => Some((38, v - 30)),
+            40..=47 => Some((48, v - 40)),
+            90..=97 => Some((38, v - 90 + 8)),
+            100..=107 => Some((48, v - 100 + 8)),
+            _ => None,
+        };
+        if let Some((kind, n)) = pair {
+            out.extend([kind.to_string(), "5".into(), n.to_string()]);
+        } else {
+            out.push(v.to_string());
+        }
+        i += 1;
+    }
+    out.join(";")
+}
+pub fn protection(bits: u32) -> String {
+    "hsparwed"
+        .chars()
+        .enumerate()
+        .map(|(i, c)| {
+            let set = bits & (1 << (7 - i)) != 0;
+            if set == (i < 4) { c } else { '-' }
+        })
+        .collect()
+}
