+pub fn filename(bytes: &[u8]) -> String {
+    let parent = bytes.ends_with(b"//");
+    let bytes = if !parent && bytes.len() > 1 && bytes.ends_with(b"/") {
+        &bytes[..bytes.len() - 1]
+    } else {
+        bytes
+    };
+    let end = bytes.len();
+    let mut start = bytes
+        .iter()
+        .rposition(|b| *b == b'/' || *b == b':')
+        .map_or(0, |i| i + 1);
+    if parent || start == end {
+        start = 0;
+    }
+    let mut input = &bytes[start..];
+    let mut out = String::new();
+    while !input.is_empty() {
+        match std::str::from_utf8(input) {
+            Ok(text) => {
+                out.push_str(text);
+                break;
+            }
+            Err(e) => {
+                let valid = e.valid_up_to();
+                out.push_str(std::str::from_utf8(&input[..valid]).unwrap());
+                let n = e.error_len().unwrap_or(input.len() - valid);
+                for b in &input[valid..valid + n] {
+                    out.push_str(&format!("\\x{b:02x}"));
+                }
+                input = &input[valid + n..];
+            }
+        }
+    }
+    out
+}
