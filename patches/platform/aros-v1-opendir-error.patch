From 7d27a20d8562229d72ff788828e55b17dc9605a3 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Thu, 22 Oct 2026 01:58:12 +0200
Subject: [PATCH 1/2] posixc: fail opendir() cleanly when no descriptor slot is
 available

opendir() stored the result of __getfdslot() with __setfdesc() without
checking it. __getfdslot() returns -1 when growing the descriptor array
fails or when fd.library refuses to reserve the number, and __setfdesc(-1)
writes before the start of the array; opendir() then returned a DIR whose
descriptor is -1. Check the slot: on failure free the descriptor and leave
through the existing cleanup, so the control block, lock, FileInfoBlock
and DIR are released and opendir() returns NULL.

__getfdslot() also returned -1 without setting errno when AllocPooled()
failed to grow the array; set ENOMEM there. When fd.library refuses the
number, the error it set is kept.
---
 compiler/crt/posixc/__fdesc.c | 6 +++++-
 compiler/crt/posixc/opendir.c | 6 ++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/compiler/crt/posixc/__fdesc.c b/compiler/crt/posixc/__fdesc.c
index 9866de72..f01baf10 100644
--- a/compiler/crt/posixc/__fdesc.c
+++ b/compiler/crt/posixc/__fdesc.c
@@ -250,7 +250,11 @@ int __getfdslot(int wanted_fd)
            before stdc.library's relbase is available. */
         tmp = AllocPooled(FD_POOL(PosixCBase), (wanted_fd+1)*sizeof(fdesc *));
 
-        if (!tmp) { FD_UNLOCK(PosixCBase); return -1; }
+        if (!tmp) {
+            FD_UNLOCK(PosixCBase);
+            __set_errno(PosixCBase, ENOMEM);
+            return -1;
+        }
 
         if (FD_ARRAY(PosixCBase))
         {
diff --git a/compiler/crt/posixc/opendir.c b/compiler/crt/posixc/opendir.c
index b3b5d54e..5eee379e 100644
--- a/compiler/crt/posixc/opendir.c
+++ b/compiler/crt/posixc/opendir.c
@@ -141,6 +141,12 @@
     desc->fcb->privflags |= _FCB_ISDIR;
 
     fd = __getfdslot(__getfirstfd(3));
+    /* Slot allocation may fail; never publish through a negative index. */
+    if (fd < 0)
+    {
+        __free_fdesc(desc);
+        goto err5;
+    }
     __setfdesc(fd, desc);
 
     dir->fd = fd;
