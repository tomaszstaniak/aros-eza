+/*
+ * crt.library realpath() returns ENOENT for AmigaDOS paths such as
+ * "RAM:dir", so repository open failed with "failed to resolve path".
+ * Ask the filesystem for the canonical name instead. Callers pass
+ * GIT_PATH_MAX buffers. "." is the current directory in POSIX terms only;
+ * AmigaDOS names it with the empty string.
+ */
+char *p_realpath(const char *pathname, char *resolved)
+{
+	char buf[GIT_PATH_MAX];
+	const char *name = strcmp(pathname, ".") ? pathname : "";
+	BPTR lock = Lock((CONST_STRPTR)name, ACCESS_READ);
+	LONG error;
+
+	if (!lock) {
+		error = IoErr();
+		errno = (error == ERROR_OBJECT_NOT_FOUND || error == ERROR_DIR_NOT_FOUND ||
+		         error == ERROR_DEVICE_NOT_MOUNTED) ? ENOENT : EACCES;
+		return NULL;
+	}
+	if (!NameFromLock(lock, (STRPTR)buf, sizeof(buf))) {
+		UnLock(lock);
+		errno = ENAMETOOLONG;
+		return NULL;
+	}
+	UnLock(lock);
+
+	if (!resolved)
+		return git__strdup(buf);
+	memcpy(resolved, buf, strlen(buf) + 1);
+	return resolved;
+}
+
+#elif !defined(GIT_WIN32)
 
