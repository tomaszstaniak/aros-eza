+#ifdef __AROS__
+#include <pthread.h>
+/* AROS has no pread/pwrite entry points. Serialize seek + I/O and restore
+ * the descriptor position; refuse offsets the SDK off_t cannot represent. */
+static pthread_mutex_t aros_io_mutex = PTHREAD_MUTEX_INITIALIZER;
+static ssize_t aros_positioned_io(int fd, void *data, size_t size, off64_t offset, int writing)
+{
+ off_t saved, target = (off_t)offset;
+ ssize_t result = -1;
+ int error;
+ if ((off64_t)target != offset) { errno = EOVERFLOW; return -1; }
+ error = pthread_mutex_lock(&aros_io_mutex);
+ if (error) { errno = error; return -1; }
+ saved = lseek(fd, 0, SEEK_CUR);
+ if (saved != (off_t)-1 && lseek(fd, target, SEEK_SET) != (off_t)-1) {
+  result = writing ? write(fd, data, size) : read(fd, data, size);
+  error = errno;
+  if (lseek(fd, saved, SEEK_SET) == (off_t)-1) result = -1;
+  else errno = error;
+ }
+ error = errno;
+ pthread_mutex_unlock(&aros_io_mutex);
+ errno = error;
+ return result;
+}
+ssize_t p_pread(int fd, void *data, size_t size, off64_t offset)
+{ return aros_positioned_io(fd, data, size, offset, 0); }
+ssize_t p_pwrite(int fd, const void *data, size_t size, off64_t offset)
+{ return aros_positioned_io(fd, (void *)data, size, offset, 1); }
 #endif
